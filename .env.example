# ShiftSync Environment Configuration Template
# Copy this file to .env and populate the values for your environment.

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

DJANGO_SECRET_KEY=
DJANGO_DEBUG=
DJANGO_ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=

NLP_PROVIDER=
NLP_LOW_CONFIDENCE_THRESHOLD=

# Real Email Delivery (SMTP) - Gmail / Custom Configuration
# Leave EMAIL_HOST empty in local dev to print to console, or provide real SMTP credentials
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL="Kenya Airways ShiftSync <your-email@gmail.com>"
FRONTEND_URL="http://127.0.0.1:5173"
